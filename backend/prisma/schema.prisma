// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  password  String
  username  String
  email     String?
  createdAt DateTime @default(now())

  devices       Device[]
  playlists     Playlist[]
  sentFriendships     Friendship[] @relation("Requester")
  receivedFriendships Friendship[] @relation("Addressee")
  playlistships Playlistship[]
}

model Friendship {
  requesterId Int
  addresseeId Int
  status       InvitationStatus
  createdAt    DateTime @default(now())

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@id([requesterId, addresseeId])
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Playlistship {
  addresseeId Int
  playlistId   Int
  status       InvitationStatus
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [addresseeId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@id([playlistId, addresseeId])
}

model Device {
  id       Int           @id @default(autoincrement())
  ownerId  Int
  name     String?
  license  LicenseStatus

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

}
enum LicenseStatus {
  NONE
  TRIAL
  EVERYTHING
}

model Playlist {
  id        Int      @id @default(autoincrement())
  isPublic  Boolean
  title     String
  userId    Int
  status    String
  createdAt DateTime @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistships Playlistship[]

  @@index([title])
}

model Music {
  id         Int      @id @default(autoincrement())
  spotifyId  Int?
  title      String
  duration   Int
  createdAt  DateTime @default(now())
  albumIndex Int

  albumId Int
  album   Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  artists ArtistMusic[]

  @@index([title])
}

model Album {
  id        Int      @id @default(autoincrement())
  spotifyId Int?
  title     String
  date      DateTime
  images    String[]
  coverUrl  String?
  createdAt DateTime @default(now())

  music    Music[]
  artists  ArtistAlbum[]

  @@index([title])
}

model Artist {
  id        Int      @id @default(autoincrement())
  title     String
  images    String[]
  createdAt DateTime @default(now())

  musics ArtistMusic[]
  albums ArtistAlbum[]

  @@index([title])
}

model ArtistMusic {
  artistId Int
  musicId  Int
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  music  Music  @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@id([artistId, musicId])

  @@index([musicId])
}

model ArtistAlbum {
  artistId Int
  albumId  Int
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([artistId, albumId])

  @@index([albumId])
}




